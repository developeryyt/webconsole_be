# Copy this file to `.env` and fill in your values. `.env` is gitignored.

SSH_HOST=example.com
SSH_PORT=22
SSH_USERNAME=ubuntu

# "key" (default) or "password"
SSH_AUTH_METHOD=key

# Used when SSH_AUTH_METHOD=key
SSH_PRIVATE_KEY_PATH=/home/you/.ssh/id_ed25519
SSH_PRIVATE_KEY_PASSPHRASE=

# Used when SSH_AUTH_METHOD=password
SSH_PASSWORD=

# If "true", host keys not yet in ~/.ssh/known_hosts are trusted and saved
# automatically instead of the connection being rejected. Default: false.
SSH_TRUST_UNKNOWN_HOSTS=false
